# Netflix4U Environment Configuration
PORT=4173
NODE_ENV=production

# Server Security & Rate Limiting
MAX_REQUESTS_PER_WINDOW=600
RATE_LIMIT_WINDOW_MS=60000

# Metadata & API Secrets (Server-Side Only - Never exposed to client)
HICINE_API_BASE=https://api.hicine.sbs
HICINE_KEY=your_hicine_secret_key_here
TMDB_API_KEY=your_tmdb_api_key_here

# Playback & Streaming Infrastructure
ALLMOVIELAND_STREAM_BASE=https://slast430did.com/play/
DOTMOBIZ_BASE_URL=https://dotmobiz.com/
