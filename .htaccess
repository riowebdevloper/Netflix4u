# ==========================================
# 🚀 Netflix4U cPanel Apache & SPA Routing
# ==========================================

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 🔒 Security: Block sensitive system files and bulk raw database dumps
  RewriteRule ^\.env - [F,L]
  RewriteRule ^\.git - [F,L]
  RewriteRule ^package\.json$ - [F,L]
  RewriteRule ^package-lock\.json$ - [F,L]
  RewriteRule ^data/details_map\.json$ - [F,L]
  RewriteRule ^data/movies\.json$ - [F,L]
  RewriteRule ^data/series\.json$ - [F,L]
  RewriteRule ^scratch/ - [F,L]

  # 2. ⚡ Dynamic API Resolvers for cPanel / LiteSpeed & Apache
  RewriteRule ^api/download-file/?$ api/download.php [QSA,L]
  RewriteRule ^api/download/hicine/?$ api/download.php [QSA,L]
  RewriteRule ^api/download/server/?$ api/download.php [QSA,L]
  RewriteRule ^api/download/?$ api/download.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]
  RewriteRule ^api/cast/?$ api/cast.php [QSA,L]
  RewriteRule ^api/poster-resolver/?$ api/poster-resolver.php [QSA,L]
  RewriteRule ^api/trailer/?$ api/trailer.php [QSA,L]
  RewriteRule ^api/tmdb/(.*)$ api/tmdb.php?endpoint=$1 [QSA,L]

  # 2b. 🛡️ Clean URLs for E-E-A-T Trust & Policy Pages
  RewriteRule ^about/?$ about.html [L]
  RewriteRule ^contact/?$ contact.html [L]
  RewriteRule ^privacy/?$ privacy.html [L]
  RewriteRule ^terms/?$ terms.html [L]
  RewriteRule ^dmca/?$ dmca.html [L]
  RewriteRule ^editorial-policy/?$ editorial-policy.html [L]
  RewriteRule ^corrections-policy/?$ corrections-policy.html [L]

  # 3. 🛑 Terminal Guard: Stop processing if request is already for index.html
  RewriteRule ^index\.html$ - [L]

  # 4. 📁 Allow existing physical files and directories (js, css, images, fonts, data, php)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. 🚫 Missing Static Asset Guard: Return 404 for missing assets so they never serve index.html (prevents MIME SyntaxError and image loops)
  RewriteCond %{REQUEST_URI} \.(?:js|css|png|jpg|jpeg|gif|webp|svg|ico|woff2?|ttf|json|map)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 6. 🎯 SPA React Fallback: Route only genuine frontend client routes to index.html safely
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/index\.html$
  RewriteRule ^.*$ /index.html [L]
</IfModule>

# ==========================================
# ⚡ High-Speed Browser Caching & Security Headers
# ==========================================
<IfModule mod_headers.c>
  # Security Headers (Best Practices 100/100)
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Zero-stale for Service Worker, HTML, and version.json
  <FilesMatch "(version\.json|sw\.js|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Immutable caching for static assets
  <FilesMatch "\.(css|js|woff2?|ttf|webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
</IfModule>

# ==========================================
# 📦 Gzip Compression for Ultra-Fast Loads
# ==========================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
